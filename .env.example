# All of these are optional build-time settings. The studio's WhatsApp number and
# contact email are defaults in src/lib/site.ts, so the site deep-links
# correctly with no .env file at all.

# Override the WhatsApp number. International format, no "+" and no spaces.
# Example: 9715XXXXXXXX
# Left blank, the default in src/lib/site.ts is used.
NEXT_PUBLIC_WHATSAPP=
# Override the public business inbox.
NEXT_PUBLIC_CONTACT_EMAIL=
# Full canonical origin. This is also the indexing switch: set it to
# https://havenly.ae and the build drops the noindex header and meta tag, so
# the site may appear in search results. Any other value, or none, keeps every
# URL hidden. Leave it blank for staging and local builds — set it in the
# Cloudflare dashboard for the production deploy instead.
NEXT_PUBLIC_SITE_URL=
# Google Tag Manager container ID, e.g. GTM-XXXXXXX. Unset = no GTM.
# Production only: set it in the Cloudflare dashboard, not for staging, so test
# traffic never reaches the reports. A malformed value fails the build.
NEXT_PUBLIC_GTM_ID=
# Google Ads tag ID, e.g. AW-123456789. Unset = no Ads tag. Leave this blank if
# the Ads tag is managed inside the GTM container instead — setting both
# double-counts conversions.
NEXT_PUBLIC_GOOGLE_ADS_ID=
